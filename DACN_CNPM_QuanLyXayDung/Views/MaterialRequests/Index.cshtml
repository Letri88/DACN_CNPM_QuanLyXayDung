@model IEnumerable<DACN_CNPM_QuanLyXayDung.Models.MaterialRequest>

@{
    ViewData["Title"] = "Yêu cầu nhập vật tư";
}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-white tracking-tight">Danh sách Yêu cầu nhập vật tư</h1>
    <a asp-action="Create" class="px-5 py-2.5 bg-primary text-background-dark font-semibold rounded-xl hover:bg-opacity-90 transition-all shadow-lg shadow-primary/20 flex items-center gap-2">
        <span class="material-icons text-sm">add</span> Thêm yêu cầu mới
    </a>
</div>

<div class="glass-card rounded-2xl border border-white/5 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-white/5 border-b border-white/5 text-slate-300 text-sm font-semibold">
                    <th class="p-4">Mã Phiếu</th>
                    <th class="p-4">Người Yêu Cầu</th>
                    <th class="p-4">Ngày Tạo</th>
                    <th class="p-4">Ngày Cần Hàng</th>
                    <th class="p-4">Trạng Thái</th>
                    <th class="p-4 text-center">Thao Tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5 text-slate-300">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-white/[0.02] transition-colors">
                        <td class="p-4 font-medium text-white">@item.RequestCode</td>
                        <td class="p-4">@(item.Creator?.FullName ?? item.CreatorId)</td>
                        <td class="p-4">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="p-4">@(item.ExpectedDate?.ToString("dd/MM/yyyy") ?? "Không yêu cầu")</td>
                        <td class="p-4">
                            @if (item.Status == "Pending")
                            {
                                <span class="px-3 py-1 rounded-full text-xs font-medium bg-amber-500/20 text-amber-400 border border-amber-500/30">Chờ duyệt</span>
                            }
                            else if (item.Status == "Approved")
                            {
                                <span class="px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">Đã duyệt</span>
                            }
                            else if (item.Status == "Rejected")
                            {
                                <span class="px-3 py-1 rounded-full text-xs font-medium bg-rose-500/20 text-rose-400 border border-rose-500/30">Từ chối</span>
                            }
                            else
                            {
                                <span class="px-3 py-1 rounded-full text-xs font-medium bg-slate-500/20 text-slate-400 border border-slate-500/30">@item.Status</span>
                            }
                        </td>
                        <td class="p-4 text-center">
                            <a asp-action="Details" asp-route-id="@item.RequestId" class="p-2 bg-blue-500/10 text-blue-400 hover:bg-blue-500/20 rounded-lg transition-colors inline-block" title="Xem chi tiết">
                                <span class="material-icons text-sm">visibility</span>
                            </a>
                        </td>
                    </tr>
                }
                @if(!Model.Any()) {
                    <tr><td colspan="6" class="p-8 text-center text-slate-500">Chưa có yêu cầu nhập vật tư nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
