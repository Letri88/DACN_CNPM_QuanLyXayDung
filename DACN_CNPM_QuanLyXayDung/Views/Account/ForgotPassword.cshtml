@{
    Layout = null;
    ViewData["Title"] = "Quên mật khẩu";
}
<!DOCTYPE html>
<html class="dark" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - StitchConstruct</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#b2ffff",
                        "background-light": "#f5f8f8",
                        "background-dark": "#0f2323",
                    },
                    fontFamily: {
                        display: ["Inter", "sans-serif"]
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0f2323; }
        .glass-panel { background: rgba(255,255,255,0.03); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.1); }
    </style>
</head>
<body class="bg-background-dark text-slate-200 font-display min-h-screen flex flex-col md:flex-row">

    <!-- Phần Form Quên Mật Khẩu (Trái) -->
    <div class="w-full md:w-1/2 lg:w-5/12 xl:w-1/3 flex flex-col justify-center p-8 md:p-12 lg:p-16 shadow-2xl z-10 bg-background-dark relative border-r border-white/5">
        <div class="w-full max-w-md mx-auto">
            <div class="mb-10">
                <h1 class="text-4xl font-bold tracking-tight text-white mb-2">Vibe<span class="text-primary">Construct</span></h1>
                <p class="text-slate-400">Yêu cầu cấp lại mật khẩu</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="bg-red-500/10 border border-red-500/20 text-red-400 p-4 rounded-xl mb-6 text-sm">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                </div>
            }

            <p class="text-sm text-slate-400 mb-6 leading-relaxed">
                Vui lòng nhập tên tài khoản của bạn. Hệ thống sẽ gửi yêu cầu cấp lại mật khẩu đến Quản trị viên để được hỗ trợ.
            </p>

            <form asp-action="ForgotPassword" method="post" class="space-y-6">
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2" for="username">
                        Tên tài khoản (Username)
                    </label>
                    <div class="relative">
                        <span class="material-icons absolute left-4 top-1/2 -translate-y-1/2 text-slate-500">
                            person
                        </span>
                        <input class="w-full bg-white/5 border border-white/10 rounded-xl py-3 pl-12 pr-4 text-sm focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-white outline-none"
                               id="username"
                               name="username"
                               type="text"
                               placeholder="Ví dụ: admin123"
                               required />
                    </div>
                </div>

                <button type="submit" class="w-full bg-primary hover:bg-primary/90 text-background-dark py-3 rounded-xl text-sm font-bold transition-all shadow-[0_4px_15px_rgba(178,255,255,0.2)]">
                    Gửi yêu cầu hỗ trợ
                </button>
            </form>

            <div class="mt-6 text-center text-sm">
                <a href="~/Account/Login" class="text-primary hover:text-white font-semibold transition-colors flex items-center justify-center gap-1">
                    <span class="material-icons text-sm">arrow_back</span>
                    Quay lại đăng nhập
                </a>
            </div>

            <div class="mt-10 text-sm text-slate-500">
                &copy; 2024 StitchConstruct.<br />Bản quyền thuộc về Con Bạc Technology.
            </div>
        </div>
    </div>

    <!-- Phần Quảng cáo (Phải) -->
    <div class="hidden md:flex flex-1 relative items-center justify-center p-12 lg:p-24 overflow-hidden bg-gradient-to-br from-[#0f2323] to-[#081212]">
        <!-- Hiệu ứng ánh sáng nền -->
        <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-primary/10 rounded-full blur-[100px]"></div>
        <div class="absolute bottom-1/4 left-1/4 w-80 h-80 bg-primary/5 rounded-full blur-[80px]"></div>
        
        <div class="relative z-10 w-full max-w-2xl">
            <h2 class="text-4xl lg:text-5xl font-light text-white mb-4 leading-tight">
                Luôn đồng hành<br />
                <span class="text-primary font-bold">và hỗ trợ bạn</span> tại<br />
                VibeConstruct
            </h2>
            <p class="text-lg text-slate-400 mb-12 max-w-lg">
                Đội ngũ Quản trị viên của chúng tôi luôn sẵn sàng hỗ trợ bạn lấy lại quyền truy cập để công việc không bị gián đoạn.
            </p>

            <div class="relative w-full max-w-lg flex items-center justify-center">
                <div class="w-32 h-32 rounded-full border-4 border-primary/20 flex items-center justify-center relative">
                    <div class="absolute inset-0 rounded-full border-t-4 border-primary animate-spin" style="animation-duration: 3s;"></div>
                    <span class="material-icons text-6xl text-primary/80">support_agent</span>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
