@model IEnumerable<DACN_CNPM_QuanLyXayDung.Models.Stage>

@{
    ViewData["Title"] = "Nhập/Xuất kho";
}

<div class="p-8 space-y-8">
    <div class="glass-panel rounded-2xl overflow-hidden">
        <div class="p-6 border-b border-white/10 flex justify-between items-center">
            <h3 class="text-lg font-bold text-white">Yêu cầu Xuất kho từ Giai đoạn</h3>
            <a asp-action="Create" asp-route-type="Nhập kho" class="px-4 py-2 bg-primary/20 text-primary hover:bg-primary/30 font-bold rounded-xl transition-colors text-sm flex items-center gap-2">
                <span class="material-icons text-sm">add_shopping_cart</span> Thêm Giao dịch Nhập kho
            </a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead class="text-slate-500 text-xs uppercase tracking-wider bg-white/5">
                    <tr>
                        <th class="px-6 py-4 font-semibold">Tên Giai đoạn</th>
                        <th class="px-6 py-4 font-semibold">Dự án</th>
                        <th class="px-6 py-4 font-semibold">File kê khai vật tư</th>
                        <th class="px-6 py-4 font-semibold">Ngày duyệt</th>
                        <th class="px-6 py-4 font-semibold text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5 text-slate-300 text-sm">
                    @if (!Model.Any()) {
                        <tr>
                            <td colspan="5" class="px-6 py-8 text-center text-slate-400">
                                Không có yêu cầu xuất kho nào đang chờ.
                            </td>
                        </tr>
                    }
                    else {
                        @foreach (var item in Model) {
                            <tr class="hover:bg-white/5 transition-colors">
                                <td class="px-6 py-4 font-medium text-white">@item.StageName</td>
                                <td class="px-6 py-4">@item.Project.ProjectName</td>
                                <td class="px-6 py-4">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Đã duyệt</span>
                                    <a asp-controller="Stages" asp-action="DownloadMaterialDeclaration" asp-route-id="@item.StageId" class="ml-2 text-xs truncate max-w-[200px] inline-block align-bottom text-emerald-400 hover:text-emerald-300 hover:underline transition-colors cursor-pointer flex items-center gap-1 mt-1" title="Tải về @item.MaterialDeclarationFileName">
                                        <span class="material-icons text-[14px]">download</span>
                                        @item.MaterialDeclarationFileName
                                    </a>
                                </td>
                                <td class="px-6 py-4">@(item.MaterialDeclarationUploadedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                <td class="px-6 py-4 text-right">
                                    <a asp-controller="InventoryTransactions" asp-action="Create" 
                                       asp-route-type="Xuất kho" 
                                       asp-route-projectId="@item.ProjectId" 
                                       asp-route-stageId="@item.StageId"
                                       class="inline-flex items-center gap-2 bg-amber-500/20 hover:bg-amber-500/30 text-amber-500 font-bold py-1.5 px-3 rounded-xl transition-colors border border-amber-500/20">
                                        <span class="material-icons text-sm">outbox</span>
                                        Xuất vật tư
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
