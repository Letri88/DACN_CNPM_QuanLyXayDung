@model DACN_CNPM_QuanLyXayDung.Models.Project

@{
    ViewData["Title"] = "Chi tiết Dự án";
}

<div class="p-8 space-y-8">
    <div class="max-w-3xl mx-auto">
        <div class="glass-card p-8 rounded-2xl relative overflow-hidden">
            <!-- Decorative blur -->
            <div class="absolute -right-20 -top-20 w-64 h-64 bg-primary/5 rounded-full blur-3xl"></div>
            
            <div class="flex justify-between items-start mb-8 relative z-10">
                <div>
                    <h3 class="text-2xl font-bold text-white mb-2">@Model.ProjectName</h3>
                    <div class="flex items-center gap-3">
                        <span class="text-sm text-slate-400 font-mono bg-white/5 py-1 px-3 rounded-lg border border-white/10">ID: PRJ-@Model.ProjectId</span>
                        @if (Model.Status == "Planned" || Model.Status == "Pending")
                        {
                            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase bg-amber-500/10 text-amber-400 border border-amber-500/20">@Model.Status</span>
                        }
                        else if (Model.Status == "Active" || Model.Status == "In Progress")
                        {
                            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">@Model.Status</span>
                        }
                        else
                        {
                            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase bg-white/10 text-slate-300 border border-white/20">@Model.Status</span>
                        }
                    </div>
                </div>
                <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center text-primary border border-primary/20 shadow-lg shadow-primary/5">
                    <span class="material-icons text-3xl">construction</span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 relative z-10">
                <div class="space-y-6">
                    <div>
                        <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">@Html.DisplayNameFor(model => model.Description)</p>
                        <p class="text-slate-300 text-sm leading-relaxed">@Html.DisplayFor(model => model.Description)</p>
                    </div>
                    <div>
                        <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">@Html.DisplayNameFor(model => model.Manager)</p>
                        <div class="flex items-center gap-3 mt-2">
                            <div class="w-8 h-8 rounded-full bg-slate-700 flex items-center justify-center text-xs font-bold text-white border-2 border-background-dark" title="ID: @(Model.Manager?.UserId.ToString() ?? "?")">
                                @(Model.Manager != null && !string.IsNullOrEmpty(Model.Manager.FullName) ? Model.Manager.FullName.Substring(0, 1).ToUpper() : "?")
                            </div>
                            <div>
                                <p class="text-white font-medium text-sm">@(Model.Manager?.FullName ?? "Chưa chỉ định")</p>
                                @{
                                    var roleNameDetail = Model.Manager?.Role?.RoleName?.Trim().ToLower() switch {
                                        "admin" => "Quản trị viên",
                                        "project manager" => "Quản lý dự án",
                                        "engineer" => "Kỹ sư",
                                        "warehouse keeper" => "Thủ kho",
                                        _ => Model.Manager?.Role?.RoleName
                                    };
                                }
                                @if(!string.IsNullOrEmpty(roleNameDetail)) {
                                    <p class="text-[10px] text-slate-400">@roleNameDetail</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="space-y-6 bg-white/5 p-5 rounded-xl border border-white/5">
                    <div>
                        <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">@Html.DisplayNameFor(model => model.Budget)</p>
                        <span class="material-icons text-sm text-emerald-400">payments</span>
                         <span class="text-emerald-400 font-bold">@((Model.Budget ?? 0).ToString("N0")) đ</span>
                        @if (Model.BudgetLocked)
                        {
                            <div class="text-[12px] text-emerald-400 mt-2">
                                Budget đã được khóa theo hợp đồng.
                            </div>
                        }
                    </div>

                    @if (Model.ContractFileContent != null && Model.ContractFileContent.Length > 0)
                    {
                        <div class="mt-4">
                            <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">
                                Hợp đồng đã upload
                            </p>
                            <div class="flex items-center justify-between gap-3">
                                <div class="text-slate-300 text-sm truncate">
                                    @Model.ContractFileName
                                </div>
                                <a asp-action="DownloadContract"
                                   asp-route-id="@Model.ProjectId"
                                   class="text-sm bg-primary/20 hover:bg-primary/30 text-primary px-4 py-2 rounded-lg transition-colors border border-primary/20">
                                    Xem/Tải PDF
                                </a>
                            </div>
                            @if (Model.ContractUploadedAt != null)
                            {
                                <div class="text-xs text-slate-400 mt-2">
                                    Lúc: @Model.ContractUploadedAt?.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            }
                        </div>
                    }
                    <div class="grid grid-cols-2 gap-6 pt-4 border-t border-white/5">
                        <div>
                            <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">@Html.DisplayNameFor(model => model.StartDate)</p>
                            <p class="text-white font-medium flex items-center gap-2">
                                <span class="material-icons text-sm text-slate-400">event</span>
                                @(Model.StartDate?.ToString("dd/MM/yyyy") ?? "-")
                            </p>
                        </div>
                        <div>
                            <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">@Html.DisplayNameFor(model => model.EndDate)</p>
                            <p class="text-white font-medium flex items-center gap-2">
                                <span class="material-icons text-sm text-slate-400">event_available</span>
                                @(Model.EndDate?.ToString("dd/MM/yyyy") ?? "-")
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stages List Section -->
            <div class="mt-8 relative z-10">
                <div class="flex items-center justify-between mb-4 border-b border-white/10 pb-4">
                    <h4 class="text-xl font-bold text-white flex items-center gap-2">
                        <span class="material-icons text-blue-400 rounded-lg bg-blue-400/10 p-1.5">view_timeline</span>
                        Danh sách Giai đoạn
                    </h4>
                    @if (User.IsInRole("Admin") || User.IsInRole("Project Manager") || User.IsInRole("Quản trị viên") || User.IsInRole("Quản lý dự án"))
                    {
                        <a asp-controller="Stages" asp-action="Create" class="px-3 py-1.5 bg-primary/20 text-primary hover:bg-primary/30 font-bold rounded-xl transition-colors text-xs flex items-center gap-1">
                            <span class="material-icons text-xs">add</span> 
                            Thêm giai đoạn
                        </a>
                    }
                </div>
                
                @if (Model.Stages != null && Model.Stages.Any())
                {
                    <div class="space-y-4">
                        @foreach (var stage in Model.Stages)
                        {
                            <div class="bg-white/5 rounded-xl border border-white/5 p-5">
                                <div class="flex justify-between items-start mb-4">
                                    <div class="flex items-center gap-3">
                                        <h5 class="text-lg font-bold text-white">@stage.StageName</h5>
                                        @if(stage.Status == "Planned" || stage.Status == "Pending") {
                                            <span class="px-2 py-0.5 rounded border border-amber-500/20 text-[10px] uppercase font-bold bg-amber-500/10 text-amber-400">@stage.Status</span>
                                        } else if (stage.Status == "Active" || stage.Status == "In Progress") {
                                            <span class="px-2 py-0.5 rounded border border-emerald-500/20 text-[10px] uppercase font-bold bg-emerald-500/10 text-emerald-400">@stage.Status</span>
                                        } else {
                                            <span class="px-2 py-0.5 rounded border border-white/20 text-[10px] uppercase font-bold bg-white/10 text-slate-300">@stage.Status</span>
                                        }
                                    </div>
                                    <a asp-controller="Stages" asp-action="Details" asp-route-id="@stage.StageId" class="text-xs text-primary hover:text-primary/80 flex items-center gap-1 bg-primary/10 px-3 py-1.5 rounded-lg transition-colors">
                                        Chi tiết <span class="material-icons text-[14px]">chevron_right</span>
                                    </a>
                                </div>
                                <div class="grid grid-cols-2 gap-4 mb-4 text-xs">
                                    <div class="flex items-center gap-2 text-slate-300">
                                        <span class="material-icons text-[14px] text-slate-500">event</span>
                                        @(stage.StartDate?.ToString("dd/MM/yyyy") ?? "-") &rarr; @(stage.EndDate?.ToString("dd/MM/yyyy") ?? "-")
                                    </div>
                                    <div class="flex items-center gap-2 text-slate-300">
                                        <span class="material-icons text-[14px] text-slate-500">person</span>
                                        Người phụ trách: @(stage.AssignedUser?.FullName ?? "Chưa phân công")
                                    </div>
                                </div>
                                
                                <!-- Tasks -->
                                @if (stage.Tasks != null && stage.Tasks.Any())
                                {
                                    <div class="bg-background-dark/50 rounded-lg p-4 border border-white/5">
                                        <h6 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Công việc thuộc giai đoạn</h6>
                                        <ul class="space-y-2">
                                            @foreach (var task in stage.Tasks)
                                            {
                                                <li class="flex items-center justify-between text-sm p-2 hover:bg-white/5 rounded-md transition-colors">
                                                    <div class="flex items-center gap-2">
                                                        <span class="material-icons text-[16px] text-slate-500">task_alt</span>
                                                        <span class="text-slate-200">@task.TaskName</span>
                                                    </div>
                                                    <div class="flex items-center gap-4">
                                                        <span class="text-xs text-slate-500">@(task.StartDate?.ToString("dd/MM/yy") ?? "-") &rarr; @(task.EndDate?.ToString("dd/MM/yy") ?? "-")</span>
                                                        @if(task.Status == "Planned" || task.Status == "Pending" || task.Status == "Not Started") {
                                                            <span class="px-2 py-0.5 rounded border border-amber-500/20 text-[10px] uppercase font-bold bg-amber-500/10 text-amber-400">@task.Status</span>
                                                        } else if (task.Status == "Active" || task.Status == "In Progress") {
                                                            <span class="px-2 py-0.5 rounded border border-blue-500/20 text-[10px] uppercase font-bold bg-blue-500/10 text-blue-400">@task.Status</span>
                                                        } else if (task.Status == "Completed" || task.Status == "Done") {
                                                            <span class="px-2 py-0.5 rounded border border-emerald-500/20 text-[10px] uppercase font-bold bg-emerald-500/10 text-emerald-400">@task.Status</span>
                                                        } else {
                                                            <span class="px-2 py-0.5 rounded border border-white/20 text-[10px] uppercase font-bold bg-white/10 text-slate-300">@task.Status</span>
                                                        }
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                                else
                                {
                                    <div class="bg-background-dark/50 rounded-lg p-3 text-center text-xs text-slate-500 border border-white/5">
                                        Chưa có công việc nào trong giai đoạn này.
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-8 bg-white/5 rounded-xl border border-white/5 border-dashed">
                        <span class="material-icons text-4xl text-white/10 mb-2">view_timeline</span>
                        <p class="text-slate-400 text-sm">Dự án này chưa có giai đoạn nào.</p>
                    </div>
                }
            </div>

            <div class="pt-6 mt-8 border-t border-white/10 flex items-center justify-between relative z-10">
                <a asp-action="Index" class="text-slate-400 hover:text-white transition-colors text-sm flex items-center gap-2">
                    <span class="material-icons text-sm">arrow_back</span> Quay lại
                </a>
                <a asp-action="Edit" asp-route-id="@Model?.ProjectId" class="bg-white/10 hover:bg-white/20 text-white font-bold py-2.5 px-6 rounded-xl transition-colors flex items-center gap-2 border border-white/10">
                    <span class="material-icons text-sm">edit</span> Chỉnh sửa
                </a>
            </div>

            <!-- Used Materials Table Section (From Warehouse Exports) -->
            @{
                var usedMaterials = ViewBag.UsedMaterials as Dictionary<string, int>;
            }
            @if (usedMaterials != null && usedMaterials.Any())
            {
                <div class="mt-8 relative z-10">
                    <div class="flex items-center justify-between mb-4 border-b border-white/10 pb-4">
                        <h4 class="text-xl font-bold text-white flex items-center gap-2">
                            <span class="material-icons text-emerald-400 rounded-lg bg-emerald-400/10 p-1.5">warehouse</span>
                            Tổng vật tư được xuất từ kho (Gom nhóm theo Dự án)
                        </h4>
                    </div>
                    <div class="bg-white/5 rounded-xl border border-white/5 overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-sm">
                                <thead>
                                    <tr class="text-slate-500 text-xs uppercase tracking-wider bg-white/5 border-b border-white/5">
                                        <th class="px-4 py-3 font-semibold">Tên vật tư</th>
                                        <th class="px-4 py-3 font-semibold text-right">Tổng số lượng đã xuất</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-white/5 text-slate-300">
                                    @foreach (var item in usedMaterials)
                                    {
                                        <tr class="hover:bg-white/5 transition-colors">
                                            <td class="px-4 py-3 font-medium text-white flex items-center gap-2">
                                                <span class="w-2 h-2 rounded-full bg-emerald-400"></span> @item.Key
                                            </td>
                                            <td class="px-4 py-3 text-right font-bold text-emerald-400">
                                                @item.Value.ToString("N0")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }



        </div>
    </div>
</div>
