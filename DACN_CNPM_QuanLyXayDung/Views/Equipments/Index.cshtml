@model IEnumerable<DACN_CNPM_QuanLyXayDung.Models.Equipment>

@{
    ViewData["Title"] = "Quản lý Thiết bị & Máy móc";
}

<div class="flex items-center justify-between mb-8">
    <div>
        <h1 class="text-3xl font-bold text-white tracking-tight">@ViewData["Title"]</h1>
        <p class="text-slate-400 mt-2">Quản lý danh sách các thiết bị, máy móc sử dụng trên công trường.</p>
    </div>
    <div class="flex gap-4">
        <a asp-action="Create" class="bg-primary text-background-dark px-6 py-3 rounded-xl font-semibold hover:bg-white transition-all shadow-lg shadow-primary/20 flex items-center gap-2">
            <span class="material-icons">add</span>
            <span>Thêm thiết bị mới</span>
        </a>
    </div>
</div>

<div class="glass-card rounded-2xl border border-white/10 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-white/5 border-b border-white/10">
                    <th class="p-4 text-sm font-semibold text-slate-300">Tên thiết bị</th>
                    <th class="p-4 text-sm font-semibold text-slate-300">Mã TB</th>
                    <th class="p-4 text-sm font-semibold text-slate-300">Loại</th>
                    <th class="p-4 text-sm font-semibold text-slate-300">Trạng thái</th>
                    <th class="p-4 text-sm font-semibold text-slate-300 text-right">Đơn giá (Ca/Giờ)</th>
                    <th class="p-4 text-sm font-semibold text-slate-300 text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
                @foreach (var item in Model) {
                    <tr class="hover:bg-white/[0.02] transition-colors">
                        <td class="p-4 text-slate-200 font-medium">@Html.DisplayFor(modelItem => item.EquipmentName)</td>
                        <td class="p-4 text-slate-400">@Html.DisplayFor(modelItem => item.EquipmentCode)</td>
                        <td class="p-4 text-slate-400">@Html.DisplayFor(modelItem => item.Type)</td>
                        <td class="p-4">
                            @if(item.Status == "Sẵn sàng")
                            {
                                <span class="px-3 py-1 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded-full text-xs font-medium">Sẵn sàng</span>
                            }
                            else if(item.Status == "Đang hoạt động")
                            {
                                <span class="px-3 py-1 bg-blue-500/20 text-blue-400 border border-blue-500/30 rounded-full text-xs font-medium">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="px-3 py-1 bg-amber-500/20 text-amber-400 border border-amber-500/30 rounded-full text-xs font-medium">@item.Status</span>
                            }
                        </td>
                        <td class="p-4 text-slate-200 text-right">@(item.HourlyRate?.ToString("N0") ?? "-") đ</td>
                        <td class="p-4 text-center">
                            <div class="flex items-center justify-center gap-2">
                                <a asp-action="Edit" asp-route-id="@item.EquipmentId" class="p-2 bg-white/5 hover:bg-blue-500/20 text-blue-400 rounded-lg transition-colors" title="Sửa">
                                    <span class="material-icons text-sm">edit</span>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.EquipmentId" class="p-2 bg-white/5 hover:bg-red-500/20 text-red-400 rounded-lg transition-colors" title="Xóa">
                                    <span class="material-icons text-sm">delete</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
