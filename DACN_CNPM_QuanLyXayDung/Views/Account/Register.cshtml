@{
    Layout = null;
    ViewData["Title"] = "Đăng ký Quản trị viên";
}
<!DOCTYPE html>
<html class="dark" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - StitchConstruct</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#b2ffff",
                        "background-light": "#f5f8f8",
                        "background-dark": "#0f2323",
                    },
                    fontFamily: {
                        display: ["Inter", "sans-serif"]
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0f2323; }
        .glass-panel { background: rgba(255,255,255,0.03); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.1); }
    </style>
</head>
<body class="bg-background-dark text-slate-200 font-display min-h-screen flex items-center justify-center p-4">

    <div class="glass-panel p-8 md:p-12 rounded-2xl w-full max-w-md shadow-[0_8px_32px_rgba(0,0,0,0.3)]">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold tracking-tight text-white mb-2">VIbe<span class="text-primary">Construct</span></h1>
            <p class="text-slate-400">Tạo tài khoản Quản trị viên (Admin)</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="bg-red-500/10 border border-red-500/20 text-red-400 p-4 rounded-xl mb-6 text-sm">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
        }

        <form asp-action="Register" method="post" class="space-y-6">
            <div>
                <label class="block text-sm font-medium text-slate-300 mb-2" for="fullName">Họ và Tên</label>
                <div class="relative">
                    <span class="material-icons absolute left-4 top-1/2 -translate-y-1/2 text-slate-500">badge</span>
                    <input class="w-full bg-white/5 border border-white/10 rounded-xl py-3 pl-12 pr-4 text-sm focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-white outline-none" 
                           id="fullName" name="fullName" type="text" placeholder="Nguyễn Văn A" required />
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-300 mb-2" for="username">Tên tài khoản (Username)</label>
                <div class="relative">
                    <span class="material-icons absolute left-4 top-1/2 -translate-y-1/2 text-slate-500">person</span>
                    <input class="w-full bg-white/5 border border-white/10 rounded-xl py-3 pl-12 pr-4 text-sm focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-white outline-none" 
                           id="username" name="username" type="text" placeholder="admin_username" required />
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-300 mb-2" for="password">Mật khẩu</label>
                <div class="relative">
                    <span class="material-icons absolute left-4 top-1/2 -translate-y-1/2 text-slate-500">lock</span>
                    <input class="w-full bg-white/5 border border-white/10 rounded-xl py-3 pl-12 pr-4 text-sm focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-white outline-none" 
                           id="password" name="password" type="password" placeholder="••••••••" required />
                </div>
            </div>
            
            <div class="bg-primary/5 border border-primary/20 rounded-xl p-4 flex items-start gap-3 mt-4">
                <span class="material-icons text-primary text-lg mt-0.5">info</span>
                <p class="text-xs text-slate-300 leading-relaxed">
                    Tài khoản được tạo thông qua trang này sẽ được cấp quyền <strong class="text-white">Admin</strong> mặc định và mật khẩu sẽ được mã hóa bằng thuật toán BCrypt.
                </p>
            </div>

            <button type="submit" class="w-full bg-primary hover:bg-primary/90 text-background-dark py-3 rounded-xl text-sm font-bold transition-all shadow-[0_4px_15px_rgba(178,255,255,0.2)] mt-6">
                Tạo tài khoản
            </button>
            
            <div class="text-center mt-6">
                <a asp-action="Login" class="text-sm border-b border-white/20 text-slate-400 hover:text-white pb-1 transition-colors">Quay lại Đăng nhập</a>
            </div>
        </form>
    </div>

</body>
</html>
