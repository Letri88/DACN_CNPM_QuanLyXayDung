@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}
<!DOCTYPE html>
<html class="dark" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - StitchConstruct</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#b2ffff",
                        "background-light": "#f5f8f8",
                        "background-dark": "#0f2323",
                    },
                    fontFamily: {
                        display: ["Inter", "sans-serif"]
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0f2323; }
        .glass-panel { background: rgba(255,255,255,0.03); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.1); }
    </style>
</head>
<body class="bg-background-dark text-slate-200 font-display min-h-screen flex flex-col md:flex-row">

    <!-- Phần Form Đăng nhập (Trái) -->
    <div class="w-full md:w-1/2 lg:w-5/12 xl:w-1/3 flex flex-col justify-center p-8 md:p-12 lg:p-16 shadow-2xl z-10 bg-background-dark relative border-r border-white/5">
        <div class="w-full max-w-md mx-auto">
            <div class="mb-10">
                <h1 class="text-4xl font-bold tracking-tight text-white mb-2">Vibe<span class="text-primary">Construct</span></h1>
                <p class="text-slate-400">Đăng nhập vào hệ thống quản lý</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 p-4 rounded-xl mb-6 text-sm text-center font-medium">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="bg-red-500/10 border border-red-500/20 text-red-400 p-4 rounded-xl mb-6 text-sm">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                </div>
            }

            <form asp-action="Login" method="post" class="space-y-6">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2" for="username">
                        Tên tài khoản (Username)
                    </label>
                    <div class="relative">
                        <span class="material-icons absolute left-4 top-1/2 -translate-y-1/2 text-slate-500">
                            person
                        </span>
                        <input class="w-full bg-white/5 border border-white/10 rounded-xl py-3 pl-12 pr-4 text-sm focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-white outline-none"
                               id="username"
                               name="username"
                               type="text"
                               placeholder="Ví dụ: admin123"
                               required
                               value="@ViewData["Username"]" />
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2" for="password">Mật khẩu</label>
                    <div class="relative">
                        <span class="material-icons absolute left-4 top-1/2 -translate-y-1/2 text-slate-500">lock</span>
                        <input class="w-full bg-white/5 border border-white/10 rounded-xl py-3 pl-12 pr-12 text-sm focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-white outline-none" 
                               id="password" name="password" type="password" placeholder="••••••••" required />
                        <button type="button" id="togglePassword" class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 hover:text-white transition-colors focus:outline-none">
                            <span class="material-icons text-xl" id="toggleIcon">visibility_off</span>
                        </button>
                    </div>
                </div>

                <div class="flex items-center justify-between text-sm">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" class="rounded border-white/20 bg-white/5 text-primary focus:ring-primary/50 focus:ring-offset-background-dark" />
                        <span class="text-slate-400 hover:text-white transition-colors">Ghi nhớ đăng nhập</span>
                    </label>
                    <a href="~/Account/ForgotPassword" class="text-primary hover:text-white transition-colors">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="w-full bg-primary hover:bg-primary/90 text-background-dark py-3 rounded-xl text-sm font-bold transition-all shadow-[0_4px_15px_rgba(178,255,255,0.2)]">
                    Đăng nhập
                </button>
            </form>

            <div class="mt-6 text-center text-sm">
                <span class="text-slate-400">Chưa có tài khoản?</span>
                <a href="~/Account/Register" class="text-primary hover:text-white font-semibold transition-colors ml-1">Đăng ký ngay</a>
            </div>

            <div class="mt-10 text-sm text-slate-500">
                &copy; 2024 StitchConstruct.<br />Bản quyền thuộc về Con Bạc Technology.
            </div>
        </div>
    </div>

    <!-- Phần Quảng cáo (Phải) -->
    <div class="hidden md:flex flex-1 relative items-center justify-center p-12 lg:p-24 overflow-hidden bg-gradient-to-br from-[#0f2323] to-[#081212]">
        <!-- Hiệu ứng ánh sáng nền -->
        <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-primary/10 rounded-full blur-[100px]"></div>
        <div class="absolute bottom-1/4 left-1/4 w-80 h-80 bg-primary/5 rounded-full blur-[80px]"></div>
        
        <div class="relative z-10 w-full max-w-2xl">
            <h2 class="text-4xl lg:text-5xl font-light text-white mb-4 leading-tight">
                Xây dựng <span class="font-bold">sự nghiệp</span><br />
                <span class="text-primary font-bold">thành công</span> cùng<br />
                VibeConstruct
            </h2>
            <p class="text-lg text-slate-400 mb-12 max-w-lg">
                Nền tảng quản lý dự án xây dựng toàn diện. Tối ưu quy trình, theo dõi tiến độ realtime và nâng cao hiệu suất đội ngũ của bạn.
            </p>

            <!-- Khối minh họa giao diện (Giống ảnh CareerLink) -->
            <div class="relative w-full max-w-lg">
                <!-- Card chính -->
                <div class="glass-panel p-6 rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.5)] transform transition-transform hover:-translate-y-2 duration-500">
                    <div class="flex items-center justify-between mb-6 border-b border-white/10 pb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-primary/20 flex items-center justify-center text-primary">
                                <span class="material-icons">search</span>
                            </div>
                            <div>
                                <div class="text-sm font-bold text-white">Tra cứu dự án...</div>
                            </div>
                        </div>
                        <span class="material-icons text-slate-500">filter_list</span>
                    </div>

                    <div class="space-y-4">
                        <!-- Item 1 -->
                        <div class="flex items-center gap-4 p-3 rounded-xl hover:bg-white/5 transition-colors cursor-pointer">
                            <div class="w-12 h-12 rounded-lg bg-slate-800 flex-shrink-0 flex items-center justify-center">
                                <span class="material-icons text-slate-400">apartment</span>
                            </div>
                            <div class="flex-1">
                                <div class="h-3 w-2/3 bg-white/20 rounded-full mb-2"></div>
                                <div class="h-2 w-1/2 bg-white/10 rounded-full"></div>
                            </div>
                            <span class="material-icons text-primary/70 text-sm">favorite_border</span>
                        </div>
                        <!-- Item 2 -->
                        <div class="flex items-center gap-4 p-3 rounded-xl hover:bg-white/5 transition-colors cursor-pointer">
                            <div class="w-12 h-12 rounded-lg bg-slate-800 flex-shrink-0 flex items-center justify-center">
                                <span class="material-icons text-slate-400">engineering</span>
                            </div>
                            <div class="flex-1">
                                <div class="h-3 w-3/4 bg-white/20 rounded-full mb-2"></div>
                                <div class="h-2 w-1/3 bg-white/10 rounded-full"></div>
                            </div>
                            <span class="material-icons text-primary text-sm">favorite</span>
                        </div>
                    </div>
                </div>

                <!-- Card nổi thông báo nhỏ -->
                <div class="absolute -bottom-6 -left-6 glass-panel p-4 rounded-xl shadow-xl flex items-center gap-3 animate-bounce" style="animation-duration: 3s;">
                    <div class="w-8 h-8 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center">
                        <span class="material-icons text-sm">celebration</span>
                    </div>
                    <div>
                        <div class="text-sm font-bold text-white">Dự án hoàn thành!</div>
                        <div class="text-xs text-slate-400">Tuyệt vời</div>
                    </div>
                </div>

                <!-- Card nổi thống kê -->
                <div class="absolute -top-6 -right-6 glass-panel p-4 rounded-xl shadow-xl flex flex-col items-center justify-center min-w-[100px]">
                    <div class="flex items-center gap-2 mb-1">
                        <span class="material-icons text-primary text-sm">visibility</span>
                        <span class="font-bold text-white text-lg">112</span>
                    </div>
                    <div class="text-xs text-slate-400">Người đang xem</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const togglePassword = document.getElementById('togglePassword');
        const password = document.getElementById('password');
        const toggleIcon = document.getElementById('toggleIcon');

        togglePassword.addEventListener('click', function () {
            const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
            password.setAttribute('type', type);
            toggleIcon.textContent = type === 'password' ? 'visibility_off' : 'visibility';
        });
    </script>
</body>
</html>
