@model IEnumerable<DACN_CNPM_QuanLyXayDung.Models.EquipmentDispatch>

@{
    ViewData["Title"] = "Điều động thiết bị";
}

<div class="flex items-center justify-between mb-8">
    <div>
        <h1 class="text-3xl font-bold text-white tracking-tight">@ViewData["Title"]</h1>
        <p class="text-slate-400 mt-2">Quản lý lịch phân bổ, điều động thiết bị cho các dự án/giai đoạn.</p>
    </div>
    <div class="flex gap-4">
        <a asp-action="Create" class="bg-primary text-background-dark px-6 py-3 rounded-xl font-semibold hover:bg-white transition-all shadow-lg shadow-primary/20 flex items-center gap-2">
            <span class="material-icons">add_road</span>
            <span>Điều động thiết bị</span>
        </a>
    </div>
</div>

<div class="glass-card rounded-2xl border border-white/10 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-white/5 border-b border-white/10">
                    <th class="p-4 text-sm font-semibold text-slate-300">Thiết bị</th>
                    <th class="p-4 text-sm font-semibold text-slate-300">Dự án / Giai đoạn</th>
                    <th class="p-4 text-sm font-semibold text-slate-300">Thời gian</th>
                    <th class="p-4 text-sm font-semibold text-slate-300">Trạng thái</th>
                    <th class="p-4 text-sm font-semibold text-slate-300 text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
                @foreach (var item in Model) {
                    <tr class="hover:bg-white/[0.02] transition-colors">
                        <td class="p-4">
                            <div class="font-medium text-slate-200">@Html.DisplayFor(modelItem => item.Equipment.EquipmentName)</div>
                            <div class="text-xs text-slate-500">Mã: @item.Equipment?.EquipmentCode</div>
                        </td>
                        <td class="p-4">
                            <div class="text-slate-200">@Html.DisplayFor(modelItem => item.Project.ProjectName)</div>
                            <div class="text-xs text-slate-500">@Html.DisplayFor(modelItem => item.Stage.StageName)</div>
                        </td>
                        <td class="p-4">
                            <div class="text-sm text-slate-300">@item.StartDate.ToString("dd/MM/yyyy")</div>
                            <div class="text-xs text-slate-500">Đến: @(item.EndDate?.ToString("dd/MM/yyyy") ?? "...")</div>
                        </td>
                        <td class="p-4">
                            @if(item.Status == "Đang điều động")
                            {
                                <span class="px-3 py-1 bg-blue-500/20 text-blue-400 border border-blue-500/30 rounded-full text-xs font-medium">Đang điều động</span>
                            }
                            else
                            {
                                <span class="px-3 py-1 bg-slate-500/20 text-slate-400 border border-slate-500/30 rounded-full text-xs font-medium">@item.Status</span>
                            }
                        </td>
                        <td class="p-4 text-center">
                            <div class="flex items-center justify-center gap-2">
                                <a asp-action="Edit" asp-route-id="@item.DispatchId" class="p-2 bg-white/5 hover:bg-blue-500/20 text-blue-400 rounded-lg transition-colors" title="Cập nhật">
                                    <span class="material-icons text-sm">edit</span>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.DispatchId" class="p-2 bg-white/5 hover:bg-red-500/20 text-red-400 rounded-lg transition-colors" title="Xóa">
                                    <span class="material-icons text-sm">delete</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
