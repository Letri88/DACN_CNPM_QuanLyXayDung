@{
    ViewData["Title"] = "Trang chủ";
    Layout = null;
}

<!DOCTYPE html>
<html class="dark" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - StitchConstruct</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />

    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#b2ffff",
                        "background-light": "#f5f8f8",
                        "background-dark": "#0f2323",
                    },
                    fontFamily: {
                        display: ["Inter", "sans-serif"]
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0f2323;
        }

        .glass-panel {
            background: rgba(255,255,255,0.03);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255,255,255,0.1);
        }

        .glass-card {
            background: rgba(178,255,255,0.05);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(178,255,255,0.1);
        }

        .glass-sidebar {
            background: rgba(15,35,35,0.8);
            backdrop-filter: blur(20px);
            border-right: 1px solid rgba(255,255,255,0.05);
        }

        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(255,255,255,0.02);
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(178,255,255,0.2);
            border-radius: 10px;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="bg-background-light dark:bg-background-dark text-slate-200 font-display min-h-screen flex">

    <!-- Sidebar -->
    @await Html.PartialAsync("_Sidebar")

    <!-- Main Content -->
    <main class="ml-64 flex-1 min-h-screen flex flex-col">

        <!-- Header -->
        @await Html.PartialAsync("_Header")

        <!-- Body -->
        <div class="p-8 space-y-8 flex-1 relative">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="absolute top-4 left-1/2 -translate-x-1/2 z-50 bg-emerald-500/20 border border-emerald-500/50 text-emerald-400 px-6 py-3 rounded-xl shadow-lg shadow-emerald-500/10 flex items-center gap-3 animate-fade-in-down" id="global-success-toast">
                    <span class="material-icons">check_circle</span>
                    <span class="font-medium text-sm">@TempData["SuccessMessage"]</span>
                    <button onclick="document.getElementById('global-success-toast').remove()" class="ml-4 hover:text-emerald-300 transition-colors">
                        <span class="material-icons text-sm">close</span>
                    </button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="absolute top-4 left-1/2 -translate-x-1/2 z-50 bg-red-500/20 border border-red-500/50 text-red-400 px-6 py-3 rounded-xl shadow-lg shadow-red-500/10 flex items-center gap-3 animate-fade-in-down" id="global-error-toast">
                    <span class="material-icons">error</span>
                    <span class="font-medium text-sm">@TempData["ErrorMessage"]</span>
                    <button onclick="document.getElementById('global-error-toast').remove()" class="ml-4 hover:text-red-300 transition-colors">
                        <span class="material-icons text-sm">close</span>
                    </button>
                </div>
            }

            @RenderBody()
        </div>

        <!-- Footer -->
        <footer class="mt-auto p-8 border-t border-white/5 flex justify-between items-center text-slate-500 text-xs">
            <p>© 2024 StitchConstruct. Bản quyền thuộc về Con Bạc Technology.</p>
            <div class="flex gap-6">
                <a class="hover:text-primary transition-colors" href="#">Điều khoản</a>
                <a class="hover:text-primary transition-colors" href="#">Hỗ trợ kỹ thuật</a>
                <a class="hover:text-primary transition-colors" href="#">V1.4.2-Stable</a>
            </div>
        </footer>

    </main>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>