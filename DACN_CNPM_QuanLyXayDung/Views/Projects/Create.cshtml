@model DACN_CNPM_QuanLyXayDung.Models.Project

@{
    ViewData["Title"] = "Thêm Dự án mới";
}

<div class="p-8 space-y-8">
    <div class="max-w-2xl mx-auto">
        <div class="glass-panel rounded-2xl p-6">
            <h3 class="text-xl font-bold text-white mb-6">Thêm Dự án mới</h3>
            <form asp-action="Create" enctype="multipart/form-data" class="space-y-4">
                <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm mb-4"></div>
                
                <div>
                    <label asp-for="ProjectName" class="text-sm font-medium text-slate-300 mb-1 block"></label>
                    <input asp-for="ProjectName" class="bg-white/5 border border-white/10 rounded-lg text-white p-2.5 focus:border-primary focus:ring-1 focus:ring-primary w-full transition-all" />
                    <span asp-validation-for="ProjectName" class="text-red-400 text-xs mt-1 block"></span>
                </div>
                
                <div>
                    <label asp-for="Description" class="text-sm font-medium text-slate-300 mb-1 block"></label>
                    <textarea asp-for="Description" rows="3" class="bg-white/5 border border-white/10 rounded-lg text-white p-2.5 focus:border-primary focus:ring-1 focus:ring-primary w-full transition-all"></textarea>
                    <span asp-validation-for="Description" class="text-red-400 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label class="text-sm font-medium text-slate-300 mb-1 block" for="contractFile">
                        Hợp đồng (PDF)
                    </label>
                    <input id="contractFile" name="contractFile" type="file" accept=".pdf,application/pdf"
                           class="bg-white/5 border border-white/10 rounded-lg text-white p-2.5 focus:border-primary focus:ring-1 focus:ring-primary w-full transition-all" />
                    <div id="ContractBudgetError" class="text-red-400 text-xs mt-2"></div>
                    <div class="text-slate-300 text-xs mt-1 block">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Budget" class="text-sm font-medium text-slate-300 mb-1 block"></label>
                        <input asp-for="Budget" id="Budget" class="bg-white/5 border border-white/10 rounded-lg text-white p-2.5 focus:border-primary focus:ring-1 focus:ring-primary w-full transition-all" />
                        <span asp-validation-for="Budget" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="ManagerId" class="text-sm font-medium text-slate-300 mb-1 block"></label>
                        <select asp-for="ManagerId" class="bg-[#1a2e2e] border border-white/10 rounded-lg text-white p-2.5 focus:border-primary focus:ring-1 focus:ring-primary w-full transition-all appearance-none" asp-items="ViewBag.ManagerId">
                            <option value="">-- Chọn Quản lý --</option>
                        </select>
                        <span asp-validation-for="ManagerId" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="StartDate" class="text-sm font-medium text-slate-300 mb-1 block"></label>
                        <input asp-for="StartDate" type="date" class="bg-white/5 border border-white/10 rounded-lg text-white p-2.5 focus:border-primary focus:ring-1 focus:ring-primary w-full transition-all [color-scheme:dark]" />
                        <span asp-validation-for="StartDate" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="EndDate" class="text-sm font-medium text-slate-300 mb-1 block"></label>
                        <input asp-for="EndDate" type="date" class="bg-white/5 border border-white/10 rounded-lg text-white p-2.5 focus:border-primary focus:ring-1 focus:ring-primary w-full transition-all [color-scheme:dark]" />
                        <span asp-validation-for="EndDate" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div class="pt-4 flex items-center justify-between border-t border-white/10 mt-6">
                    <a asp-action="Index" class="text-slate-400 hover:text-white transition-colors text-sm flex items-center gap-2">
                        <span class="material-icons text-sm">arrow_back</span> Quay lại danh sách
                    </a>
                    <button type="submit" class="bg-primary/20 text-primary hover:bg-primary/30 font-bold py-2.5 px-6 rounded-xl transition-colors flex items-center gap-2">
                        <span class="material-icons text-sm">save</span> Tạo mới
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            const contractInput = document.getElementById('contractFile');
            const budgetInput = document.getElementById('Budget');
            const submitBtn = document.querySelector('button[type="submit"]');
            const errorBox = document.getElementById('ContractBudgetError');

            async function extractBudgetFromContractFile() {
                if (!contractInput || !budgetInput) return;

                const files = contractInput.files;
                if (!files || files.length === 0) {
                    budgetInput.disabled = false;
                    if (submitBtn) submitBtn.disabled = false;
                    return;
                }

                const file = files[0];
                if (file.name && !file.name.toLowerCase().endsWith('.pdf')) {
                    alert('Quy định hệ thống: Phải chọn đúng file định dạng PDF (.pdf).');
                    contractInput.value = '';
                    budgetInput.disabled = false;
                    if (submitBtn) submitBtn.disabled = false;
                    return;
                }

                const formData = new FormData();
                formData.append('contractFile', file);

                // Antiforgery (nếu action có validate trong tương lai).
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenInput && tokenInput.value) {
                    formData.append('__RequestVerificationToken', tokenInput.value);
                }

                if (errorBox) errorBox.textContent = '';
                if (submitBtn) submitBtn.disabled = true;

                try {
                    const response = await fetch('@Url.Action("ExtractContractBudget", "Projects")', {
                        method: 'POST',
                        body: formData
                    });

                    if (!response.ok) {
                        let msg = 'Không thể trích xuất tổng chi phí từ hợp đồng.';
                        try {
                            const data = await response.json();
                            msg = data && data.message ? data.message : msg;
                        } catch {
                            // ignore
                        }
                        if (errorBox) errorBox.textContent = msg;
                        if (submitBtn) submitBtn.disabled = false;
                        return;
                    }

                    const data = await response.json();
                    if (data && data.budget != null) {
                        // 1) điền xong
                        budgetInput.value = Number(data.budget).toFixed(2);
                        // 2) rồi mới khóa
                        budgetInput.disabled = true;
                        if (submitBtn) submitBtn.disabled = false; // cho phép submit tạo dự án
                    }
                } catch (e) {
                    if (errorBox) errorBox.textContent = 'Lỗi kết nối. Vui lòng thử lại.';
                    if (submitBtn) submitBtn.disabled = false;
                }
            }

            if (contractInput) {
                contractInput.addEventListener('change', extractBudgetFromContractFile);
            }
        })();
    </script>
}
