@model DACN_CNPM_QuanLyXayDung.Models.DashboardViewModel

@{
    ViewData["Title"] = "Trang chủ";
}

<div class="p-8 space-y-8">
    <!-- Hero & KPI Section -->
    <section class="space-y-6">
        <div>
            <h2 class="text-2xl font-bold text-white">Quản lý dự án &amp; tài nguyên</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- KPI 1 -->
            <div class="glass-card p-6 rounded-2xl relative overflow-hidden group">
                <div class="absolute -right-4 -top-4 w-24 h-24 bg-primary/5 rounded-full blur-3xl"></div>
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-slate-400 text-sm font-medium">Dự án đang chạy</p>
                        <h3 class="text-3xl font-bold text-white mt-1">@Model.ActiveProjectsCount</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                        <span class="material-icons">apartment</span>
                    </div>
                </div>
                <div class="mt-4 flex items-center gap-2 text-emerald-400 text-xs font-semibold">
                    <span class="material-icons text-sm">trending_up</span>
                    <span>Tracking active projects</span>
                </div>
            </div>
            <!-- KPI 2 -->
            <div class="glass-card p-6 rounded-2xl relative overflow-hidden group">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-slate-400 text-sm font-medium">Trễ tiến độ</p>
                        <h3 class="text-3xl font-bold text-white mt-1">@Model.DelayedProjectsCount</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-red-500/10 flex items-center justify-center text-red-400">
                        <span class="material-icons">schedule</span>
                    </div>
                </div>
                <div class="mt-4 flex items-center gap-2 text-red-400 text-xs font-semibold">
                    <span class="material-icons text-sm">warning</span>
                    <span>Cần chú ý gấp</span>
                </div>
            </div>
            <!-- KPI 3 -->
            <div class="glass-card p-6 rounded-2xl relative overflow-hidden group">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-slate-400 text-sm font-medium">Tổng chi phí</p>
                        <h3 class="text-xl font-bold text-white mt-1">@Model.TotalBudget.ToString("N0")</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-amber-500/10 flex items-center justify-center text-amber-400">
                        <span class="material-icons">payments</span>
                    </div>
                </div>
                <div class="mt-4 flex items-center gap-2 text-slate-400 text-xs">
                    <span class="material-icons text-sm">info</span>
                    <span>Tổng ngân sách dự kiến</span>
                </div>
            </div>
            <!-- KPI 4 -->
            <div class="glass-card p-6 rounded-2xl relative overflow-hidden group">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-slate-400 text-sm font-medium">Nhân sự (Active)</p>
                        <h3 class="text-3xl font-bold text-white mt-1">@Model.TotalStaff</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-400">
                        <span class="material-icons">engineering</span>
                    </div>
                </div>
                <div class="mt-4 flex items-center gap-2 text-emerald-400 text-xs font-semibold">
                    <span class="material-icons text-sm">check_circle</span>
                    <span>Hệ thống quản lý</span>
                </div>
            </div>
        </div>
    </section>
    <!-- Main Dashboard Grid -->
    <div class="grid grid-cols-12 gap-8">
        <!-- Left Column: Project Overview & Gantt -->
        <div class="col-span-8 space-y-8">
            <!-- Project Table -->
            <div class="glass-panel rounded-2xl overflow-hidden">
                <div class="p-6 border-b border-white/10 flex justify-between items-center">
                    <h3 class="text-lg font-bold text-white">Tổng quan dự án</h3>
                    <button class="text-primary text-sm font-semibold hover:underline">Xem tất cả</button>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="text-slate-500 text-xs uppercase tracking-wider">
                                <th class="px-6 py-4 font-semibold">ID</th>
                                <th class="px-6 py-4 font-semibold">Tên dự án</th>
                                <th class="px-6 py-4 font-semibold">Tiến độ</th>
                                <th class="px-6 py-4 font-semibold">Trạng thái</th>
                                <th class="px-6 py-4 font-semibold">Quản lý</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5">
                            @foreach (var project in Model.ProjectsOverview)
                            {
                                var percent = project.Stages != null && project.Stages.Any() ? project.Stages.Average(t => t.PercentComplete ?? 0) : 0;
                                <tr class="hover:bg-white/5 transition-colors">
                                    <td class="px-6 py-4 text-sm font-mono text-slate-400">PRJ-@project.ProjectId</td>
                                    <td class="px-6 py-4 text-sm font-semibold text-white">@project.ProjectName</td>
                                    <td class="px-6 py-4 min-w-[140px]">
                                        <div class="flex items-center gap-3">
                                            <div class="flex-1 h-1.5 bg-white/10 rounded-full overflow-hidden">
                                                <div class="h-full bg-primary" style="width: @Math.Round((double)percent)%"></div>
                                            </div>
                                            <span class="text-xs font-medium text-slate-300">@Math.Round((double)percent)%</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        @if(project.Status == "Planned" || project.Status == "Pending" || project.Status == "Not Started") {
                                            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase bg-amber-500/10 text-amber-400 border border-amber-500/20">@project.Status</span>
                                        } else if (project.Status == "Active" || project.Status == "In Progress") {
                                            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">@project.Status</span>
                                        } else {
                                            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase bg-white/10 text-slate-300 border border-white/20">@project.Status</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-2">
                                            <div class="w-8 h-8 rounded-full border-2 border-background-dark bg-slate-700 flex items-center justify-center text-[12px] text-white font-bold" title="@(project.Manager?.FullName ?? "Chưa phân công")">
                                                @(project.Manager != null && !string.IsNullOrEmpty(project.Manager.FullName) ? project.Manager.FullName.Substring(0, 1).ToUpper() : "?")
                                            </div>
                                            <span class="text-xs text-slate-300">@(project.Manager?.FullName ?? "Chưa chỉ định")</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Gantt Chart Preview -->
            <div class="glass-panel rounded-2xl p-6 space-y-6">
                <div class="flex justify-between items-center">
                    <h3 class="text-lg font-bold text-white">Timeline Dự án (Gantt)</h3>
                </div>
                @{
                    var ganttProjects = Model.ProjectsTimeline?.Where(p => p.StartDate.HasValue && p.EndDate.HasValue).ToList() ?? new List<Project>();
                    var hasGantt = ganttProjects.Any();
                    
                    DateOnly minDate = DateOnly.FromDateTime(DateTime.Today);
                    DateOnly maxDate = minDate.AddMonths(1);

                    if (hasGantt)
                    {
                        minDate = ganttProjects.Min(p => p.StartDate!.Value);
                        maxDate = ganttProjects.Max(p => p.EndDate!.Value);
                        
                        // Cũng xét các stage để giãn timeline nếu stage bắt đầu sớm/muộn hơn Project
                        foreach(var p in ganttProjects)
                        {
                            if(p.Stages != null && p.Stages.Any())
                            {
                                var validStages = p.Stages.Where(s => s.StartDate.HasValue && s.EndDate.HasValue).ToList();
                                if(validStages.Any())
                                {
                                    var pMinStg = validStages.Min(s => s.StartDate!.Value);
                                    var pMaxStg = validStages.Max(s => s.EndDate!.Value);
                                    if (pMinStg < minDate) minDate = pMinStg;
                                    if (pMaxStg > maxDate) maxDate = pMaxStg;
                                }
                            }
                        }
                    }
                    
                    if (maxDate <= minDate) { maxDate = minDate.AddDays(30); }
                    
                    var totalDays = maxDate.DayNumber - minDate.DayNumber + 10; 
                    var startDateAxis = minDate.AddDays(-5); 
                    var endDateAxis = startDateAxis.AddDays(totalDays);
                }

                @if(hasGantt)
                {
                    <div class="space-y-4 overflow-hidden">
                        <!-- Dates Header -->
                        <div class="grid grid-cols-12 gap-0 border-b border-white/5 pb-2">
                            <div class="col-span-3"></div>
                            <div class="col-span-9 relative h-4">
                                <div class="absolute left-0 top-0 text-[10px] font-bold text-slate-500 border-l border-white/20 pl-1">@startDateAxis.ToString("dd/MM/yyyy")</div>
                                <div class="absolute left-1/2 top-0 text-[10px] font-bold text-slate-500 border-l border-white/20 pl-1 -translate-x-1/2">@startDateAxis.AddDays(totalDays/2).ToString("dd/MM/yyyy")</div>
                                <div class="absolute right-0 top-0 text-[10px] font-bold text-slate-500 pr-1 text-right" style="transform: translateX(0);">@endDateAxis.ToString("dd/MM/yyyy")</div>
                            </div>
                        </div>
                        
                        <!-- Projects & Stages Timelines -->
                        <div class="space-y-6 relative pt-2">
                            <!-- Vertical Grid Lines -->
                            <div class="absolute inset-y-0 left-[25%] w-px bg-white/5" style="left: 25%;"></div>
                            <div class="absolute inset-y-0 left-[50%] w-px bg-white/5" style="left: 50%;"></div>
                            <div class="absolute inset-y-0 left-[75%] w-px bg-white/5" style="left: 75%;"></div>

                            @foreach (var project in ganttProjects)
                            {
                                var projStartDelay = project.StartDate!.Value.DayNumber - startDateAxis.DayNumber;
                                var projDuration = project.EndDate!.Value.DayNumber - project.StartDate.Value.DayNumber + 1;
                                var projLeftPercent = Math.Max(0, Math.Min(100.0, (projStartDelay * 100.0) / totalDays));
                                var projWidthPercent = Math.Max(0.5, Math.Min(100.0 - projLeftPercent, (projDuration * 100.0) / totalDays));

                                var statusColor = project.Status == "Completed" || project.Status == "Done" ? "bg-emerald-400" 
                                                : project.Status == "In Progress" || project.Status == "Active" ? "bg-primary"
                                                : project.Status == "Pending" || project.Status == "Planned" ? "bg-amber-400"
                                                : "bg-blue-400";
                                                
                                var barColor = project.Status == "Completed" || project.Status == "Done" ? "bg-emerald-400/30 border-emerald-400/40" 
                                                : project.Status == "In Progress" || project.Status == "Active" ? "bg-primary/40 border-primary/40"
                                                : project.Status == "Pending" || project.Status == "Planned" ? "bg-amber-400/30 border-amber-400/40"
                                                : "bg-blue-400/30 border-blue-400/40";

                                <div class="grid grid-cols-12 items-start border-b border-white/5 pb-4">
                                    <div class="col-span-3 text-sm font-medium text-slate-300 pr-4 mt-1 border-r border-white/10" title="@project.ProjectName">
                                        <div class="truncate font-bold text-white mb-1">@project.ProjectName</div>
                                        <div class="text-[10px] text-slate-400">@project.StartDate?.ToString("dd/MM/yy") - @project.EndDate?.ToString("dd/MM/yy")</div>
                                    </div>
                                    <div class="col-span-9 relative min-h-[2rem]">
                                        <!-- Project Main Bar -->
                                        <div class="absolute top-1 h-6 @barColor border rounded flex items-center justify-center overflow-hidden"
                                             style="left: @projLeftPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%; width: @projWidthPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%; min-width: 4px;"
                                             title="Dự án: @project.ProjectName&#10;Trạng thái: @project.Status">
                                             <div class="absolute bottom-0 left-0 h-1 @statusColor w-full opacity-70"></div>
                                        </div>

                                        <!-- Stages Bars -->
                                        @if(project.Stages != null && project.Stages.Any(s => s.StartDate.HasValue && s.EndDate.HasValue))
                                        {
                                            <div class="mt-8 space-y-1.5 w-full">
                                                @foreach (var stage in project.Stages.Where(s => s.StartDate.HasValue && s.EndDate.HasValue).OrderBy(s => s.StartDate))
                                                {
                                                    var stgStartDelay = stage.StartDate!.Value.DayNumber - startDateAxis.DayNumber;
                                                    var stgDuration = stage.EndDate!.Value.DayNumber - stage.StartDate.Value.DayNumber + 1;
                                                    var stgLeft = Math.Max(0, Math.Min(100.0, (stgStartDelay * 100.0) / totalDays));
                                                    var stgWidth = Math.Max(0.5, Math.Min(100.0 - stgLeft, (stgDuration * 100.0) / totalDays));

                                                    <div class="relative h-5 w-full mt-1" title="GĐ: @stage.StageName&#10;Bắt đầu: @stage.StartDate?.ToString("dd/MM/yyyy")&#10;Kết thúc: @stage.EndDate?.ToString("dd/MM/yyyy")&#10;Trạng thái: @stage.Status">
                                                        <div class="absolute top-1 h-3 bg-white/20 border border-white/30 rounded shadow hover:bg-white/30 transition-colors"
                                                             style="left: @stgLeft.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%; width: @stgWidth.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%; min-width: 4px;">
                                                             @{ var putTextLeft = (stgLeft + stgWidth) > 85; }
                                                             <span class="absolute @(putTextLeft ? "right-full mr-2" : "left-full ml-2") top-1/2 -translate-y-1/2 text-[10px] text-slate-300 whitespace-nowrap">@stage.StageName</span>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-8">
                        <p class="text-slate-400 text-sm">Chưa có dữ liệu dự án hợp lệ để hiển thị Gantt.</p>
                    </div>
                }
            </div>
        </div>
        <!-- Right Column: Resources & Risks -->
        <div class="col-span-4 space-y-8">
            <!-- Resource Snapshot -->
            <div class="glass-panel rounded-2xl p-6">
                <div class="flex justify-between items-center mb-6">
                    <h3 class="text-lg font-bold text-white">Vật tư sắp hết</h3>
                    <span class="material-icons text-slate-500">inventory</span>
                </div>
                <div class="space-y-5">
                    @if (Model.LowStockMaterials != null && Model.LowStockMaterials.Any())
                    {
                        @foreach (var mat in Model.LowStockMaterials)
                        {
                            var totalImport = mat.InventoryTransactions.Sum(x => x.Quantity);
                            var totalUsed = mat.MaterialUsages.Sum(x => x.QuantityUsage);
                            var currentStock = totalImport - totalUsed;

                            <div class="flex items-center justify-between p-3 rounded-xl bg-white/5 border border-white/5">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-lg bg-orange-500/10 flex items-center justify-center text-orange-400">
                                        <span class="material-icons">inventory_2</span>
                                    </div>
                                    <div>
                                        <p class="text-sm font-bold text-white">@mat.MaterialName</p>
                                        <p class="text-[10px] text-slate-400 uppercase">
                                            Tồn kho: @currentStock @mat.Unit
                                        </p>
                                    </div>
                                </div>

                                <div class="text-right">
                                    <p class="text-sm font-bold text-orange-400">
                                        Tối thiểu: @mat.MinStockLevel
                                    </p>
                                    <p class="text-[10px] text-slate-500">
                                        Cần nhập thêm
                                    </p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center p-4">
                            <p class="text-sm text-slate-400">Không có vật tư nào sắp hết mức lưu trữ tối thiểu.</p>
                        </div>
                    }
                </div>
                <button class="w-full mt-6 py-2.5 rounded-xl border border-white/10 text-xs font-bold text-slate-300 hover:bg-white/5 transition-colors">Xem báo cáo vật tư</button>
            </div>

        </div>
    </div>