@using System.Security.Claims
@inject DACN_CNPM_QuanLyXayDung.Models.HeThongQlvongDoiDuAnTaiNguyenContext _context
<aside class="fixed left-0 top-0 h-full w-64 glass-sidebar z-50 flex flex-col">
    <div class="p-6">
        <div class="flex items-center gap-3">
            <h1 class="text-xl font-bold tracking-tight text-white">VIbe<span class="text-primary">Construct</span></h1>
        </div>
    </div>
    <nav class="flex-1 px-4 space-y-2 mt-4">

        <a class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/5 text-slate-400 hover:text-white transition-all" href="~/">
            <span class="material-icons text-xl">dashboard</span>
            <span class="font-medium">Tổng quan</span>
        </a>

        @if (User.IsInRole("Admin") || User.IsInRole("Project Manager") || User.IsInRole("Quản trị viên") || User.IsInRole("Quản lý dự án"))
        {
            <a class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/5 text-slate-400 hover:text-white transition-all" href="~/Projects">
                <span class="material-icons text-xl">construction</span>
                <span class="font-medium">Dự án</span>
            </a>
        }

        @if (User.IsInRole("Admin") || User.IsInRole("Project Manager") || User.IsInRole("Quản trị viên") || User.IsInRole("Quản lý dự án") || User.IsInRole("Warehouse Keeper") || User.IsInRole("Warehouse keeper") || User.IsInRole("Thủ kho"))
        {
            <a class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/5 text-slate-400 hover:text-white transition-all" href="~/Stages">
                <span class="material-icons text-xl">loop</span>
                <span class="font-medium">Giai đoạn</span>
            </a>
        }

        @if (User.IsInRole("Admin") || User.IsInRole("Project Manager") || User.IsInRole("Engineer") || User.IsInRole("Quản trị viên") || User.IsInRole("Quản lý dự án") || User.IsInRole("Kỹ sư"))
        {
            <a class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/5 text-slate-400 hover:text-white transition-all" href="~/Tasks">
                <span class="material-icons text-xl">assignment</span>
                <span class="font-medium">Công việc</span>
            </a>
            
            <a class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/5 text-slate-400 hover:text-white transition-all" href="~/SiteDiaries">
                <span class="material-icons text-xl">event_note</span>
                <span class="font-medium">Nhật ký thi công</span>
            </a>
        }

        @if (User.IsInRole("Engineer") || User.IsInRole("Kỹ sư"))
        {
            var userId = User.Claims.FirstOrDefault(c => c.Type == "UserId")?.Value;
            if (!string.IsNullOrEmpty(userId))
            {
                var myStages = _context.Stages.Where(s => s.AssignedUserId == userId).ToList();
                if (myStages.Any())
                {
                    <div class="pt-4 mt-4 border-t border-white/10 mb-2">
                        <div class="px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Giai đoạn của tôi</div>
                        @foreach(var ms in myStages)
                        {
                            <a class="flex items-center gap-3 px-4 py-2 pl-8 rounded-xl hover:bg-white/5 text-slate-400 hover:text-white transition-all text-sm w-full" href="~/Stages/Details/@ms.StageId" title="@ms.StageName">
                                <span class="material-icons text-[10px] text-primary">circle</span>
                                <span class="font-medium truncate block w-full">@ms.StageName</span>
                            </a>
                        }
                    </div>
                }
            }
        }

        @if (User.IsInRole("Admin") || User.IsInRole("Warehouse Keeper") || User.IsInRole("Warehouse keeper") || User.IsInRole("Quản trị viên") || User.IsInRole("Thủ kho") || User.IsInRole("Engineer") || User.IsInRole("Kỹ sư") || User.IsInRole("Project Manager") || User.IsInRole("Quản lý dự án"))
        {
            <a class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/5 text-slate-400 hover:text-white transition-all border border-transparent hover:border-white/10" href="~/ProjectMaterialRequests">
                <span class="material-icons text-xl">precision_manufacturing</span>
                <span class="font-medium">Cấp Phát Vật Tư Dự Án</span>
            </a>
        }

        @if (User.IsInRole("Admin") || User.IsInRole("Warehouse Keeper") || User.IsInRole("Warehouse keeper") || User.IsInRole("Quản trị viên") || User.IsInRole("Thủ kho"))
        {
            <a class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/5 text-slate-400 hover:text-white transition-all" href="~/Materials">
                <span class="material-icons text-xl">inventory_2</span>
                <span class="font-medium">Tài nguyên (Vật tư)</span>
            </a>

            <a class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/5 text-slate-400 hover:text-white transition-all" href="~/Equipments">
                <span class="material-icons text-xl">agriculture</span>
                <span class="font-medium">Máy móc & Thiết bị</span>
            </a>

            <a class="flex items-center gap-3 px-4 py-3 pl-8 rounded-xl hover:bg-white/5 text-slate-400 hover:text-white transition-all text-sm" href="~/EquipmentDispatches">
                <span class="material-icons text-lg">rv_hookup</span>
                <span class="font-medium">Điều động thiết bị</span>
            </a>

            <a class="flex items-center gap-3 px-4 py-3 pl-8 rounded-xl hover:bg-white/5 text-slate-400 hover:text-white transition-all text-sm" href="~/InventoryTransactions/Requests">
                <span class="material-icons text-lg">add_shopping_cart</span>
                <span class="font-medium">Nhập/Xuất kho</span>
            </a>

            <a class="flex items-center gap-3 px-4 py-3 pl-8 rounded-xl hover:bg-white/5 text-slate-400 hover:text-white transition-all text-sm" href="~/InventoryTransactions">
                <span class="material-icons text-lg">history</span>
                <span class="font-medium">Lịch sử xuất nhập kho</span>
            </a>

            <div class="pt-2 mt-2 border-t border-white/10 mb-2">
                <div class="px-4 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Quy Trình Nhập Vật Tư</div>
                <a class="flex items-center gap-3 px-4 py-2 pl-8 rounded-xl hover:bg-white/5 text-slate-400 hover:text-white transition-all text-sm" href="~/MaterialRequests">
                    <span class="material-icons text-lg">post_add</span>
                    <span class="font-medium">Yêu cầu nhập vật tư</span>
                </a>
                <a class="flex items-center gap-3 px-4 py-2 pl-8 rounded-xl hover:bg-white/5 text-slate-400 hover:text-white transition-all text-sm" href="~/PurchaseOrders">
                    <span class="material-icons text-lg">local_shipping</span>
                    <span class="font-medium">Đơn đặt hàng (PO)</span>
                </a>
                <a class="flex items-center gap-3 px-4 py-2 pl-8 rounded-xl hover:bg-white/5 text-slate-400 hover:text-white transition-all text-sm" href="~/MaterialReceipts">
                    <span class="material-icons text-lg">inventory</span>
                    <span class="font-medium">Quản lý nhận hàng</span>
                </a>
            </div>
        }

        @if (User.IsInRole("Admin") || User.IsInRole("Quản trị viên"))
        {
            <a class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/5 text-slate-400 hover:text-white transition-all" href="~/Users">
                <span class="material-icons text-xl">groups</span>
                <span class="font-medium">Nhân sự</span>
            </a>
        }
        
        <a class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/5 text-slate-400 hover:text-white transition-all" href="#">
            <span class="material-icons text-xl">bar_chart</span>
            <span class="font-medium">Báo cáo</span>
        </a>
    </nav>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const currentPath = window.location.pathname.toLowerCase();
            let bestMatch = null;
            let longestMatch = 0;

            document.querySelectorAll('aside nav a').forEach(a => {
                const href = a.getAttribute('href');
                if (!href || href === "#") return;
                
                let path = href.replace("~", "").toLowerCase();
                if(path === "" || path === "/") {
                    if (currentPath === "/" || currentPath.endsWith("/home/index") || currentPath.endsWith("/home")) {
                         if (longestMatch === 0) bestMatch = a;
                    }
                } else {
                    if (currentPath.startsWith(path) && path.length > longestMatch) {
                        bestMatch = a;
                        longestMatch = path.length;
                    }
                }
            });

            if (bestMatch) {
                bestMatch.classList.remove('text-slate-400');
                bestMatch.classList.add('text-amber-50', 'bg-white/5', 'border-white/10');
                
                const icon = bestMatch.querySelector('.material-icons');
                if (icon) icon.classList.add('text-amber-400');
            }
        });
    </script>
</aside>