@using System.Security.Claims
@inject DACN_CNPM_QuanLyXayDung.Models.HeThongQlvongDoiDuAnTaiNguyenContext _context
<header class="h-20 glass-panel border-b-0 sticky top-0 z-40 px-8 flex items-center justify-between">
    <div class="flex-1 max-w-xl">
        <div class="relative group" id="globalSearchContainer">
            <span class="material-icons absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 group-focus-within:text-primary transition-colors z-10">search</span>
            <input id="globalSearchInput" autocomplete="off" class="w-full bg-white/5 border border-white/10 rounded-xl py-2.5 pl-12 pr-4 text-sm focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-white outline-none relative z-10" placeholder="Tìm kiếm dự án, vật tư, máy móc..." type="text" />
            
            <!-- Dropdown Results -->
            <div id="searchResultsDropdown" class="absolute left-0 right-0 top-full mt-2 bg-background-dark/95 backdrop-blur-md border border-white/10 rounded-xl shadow-[0_10px_40px_rgba(0,0,0,0.5)] opacity-0 invisible transition-all z-50 max-h-[70vh] overflow-y-auto">
                <!-- Results will be injected here via JS -->
            </div>
        </div>
    </div>
    <div class="flex items-center gap-4">
        @if (User.IsInRole("Admin") || User.IsInRole("Warehouse Keeper") || User.IsInRole("Quản trị viên") || User.IsInRole("Thủ kho"))
        {
            <a href="~/InventoryTransactions" class="bg-primary/10 hover:bg-primary/20 text-primary border border-primary/30 px-5 py-2 rounded-xl text-sm font-semibold transition-all flex items-center gap-2">
                <span class="material-icons text-lg">add_box</span>
                Nhập vật tư
            </a>
        }
        @if (User.IsInRole("Admin") || User.IsInRole("Project Manager") || User.IsInRole("Quản trị viên") || User.IsInRole("Quản lý dự án"))
        {
            <a href="~/Projects/Create" class="bg-primary hover:bg-primary/90 text-background-dark px-5 py-2 rounded-xl text-sm font-bold transition-all flex items-center gap-2 shadow-[0_4px_15px_rgba(178,255,255,0.2)]">
                <span class="material-icons text-lg">add</span>
                Tạo dự án
            </a>
        }
        <div class="h-8 w-px bg-white/10 mx-2"></div>
        @{
            var userId = User.Claims.FirstOrDefault(c => c.Type == "UserId")?.Value;
            var unreadNotifications = new List<DACN_CNPM_QuanLyXayDung.Models.Notification>();
            if (!string.IsNullOrEmpty(userId))
            {
                unreadNotifications = _context.Notifications
                    .Where(n => n.UserId == userId && !n.IsRead)
                    .OrderByDescending(n => n.CreatedAt)
                    .ToList();
            }
        }
        <div class="relative group">
            <button class="w-10 h-10 rounded-xl glass-panel flex items-center justify-center text-slate-400 hover:text-white transition-colors relative focus:outline-none">
                <span class="material-icons">notifications</span>
                @if (unreadNotifications.Any())
                {
                    <span class="absolute -top-1 -right-1 flex h-4 w-4 items-center justify-center rounded-full bg-red-500 text-[10px] font-bold text-white border border-background-dark">@unreadNotifications.Count</span>
                }
            </button>
            
            <div class="absolute right-0 mt-2 w-80 bg-background-dark/95 backdrop-blur-md border border-white/10 rounded-xl shadow-lg opacity-0 invisible group-hover:visible group-hover:opacity-100 transition-all z-50">
                <div class="p-3 border-b border-white/10 flex justify-between items-center">
                    <span class="font-semibold text-white">Thông báo</span>
                    <span class="text-xs bg-primary/20 text-primary px-2 py-0.5 rounded-full">@unreadNotifications.Count mới</span>
                </div>
                <div class="max-h-80 overflow-y-auto">
                    @if (unreadNotifications.Any())
                    {
                        foreach (var notif in unreadNotifications)
                        {
                            <form asp-controller="Notifications" asp-action="MarkAsRead" method="post" class="m-0 p-0">
                                <input type="hidden" name="id" value="@notif.NotificationId" />
                                <input type="hidden" name="returnUrl" value="@notif.RelatedUrl" />
                                <button type="submit" class="w-full text-left p-3 hover:bg-white/5 border-b border-white/5 transition-colors cursor-pointer block">
                                    <div class="text-sm text-slate-200">@notif.Message</div>
                                    <div class="text-xs text-slate-400 mt-1">@notif.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        <div class="p-4 text-center text-sm text-slate-400">Không có thông báo mới</div>
                    }
                </div>
                <div class="border-t border-white/10 p-2">
                    <a href="~/Notifications" class="block w-full text-center py-2 text-sm font-semibold text-primary hover:bg-white/5 rounded-lg transition-colors">Xem tất cả</a>
                </div>
            </div>
        </div>

        <div class="h-8 w-px bg-white/10 mx-2"></div>
        <div class="flex items-center gap-3">
            <div class="text-right hidden sm:block">
                <div class="text-sm font-semibold text-white">@(User.Identity?.Name ?? "Người dùng")</div>
                <div class="text-xs text-slate-400">@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                <button type="submit" class="w-10 h-10 rounded-xl glass-panel flex items-center justify-center text-slate-400 hover:text-red-400 transition-colors" title="Đăng xuất">
                    <span class="material-icons">logout</span>
                </button>
            </form>
        </div>
    </div>
</header>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById('globalSearchInput');
        const dropdown = document.getElementById('searchResultsDropdown');
        let debounceTimer;

        if (searchInput && dropdown) {
            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                const query = this.value.trim();

                if (query.length === 0) {
                    dropdown.classList.add('opacity-0', 'invisible');
                    dropdown.innerHTML = '';
                    return;
                }

                debounceTimer = setTimeout(() => {
                    fetch(`/api/search?q=${encodeURIComponent(query)}`)
                        .then(response => response.json())
                        .then(data => {
                            if (data.length === 0) {
                                dropdown.innerHTML = '<div class="p-4 text-center text-sm text-slate-400">Không tìm thấy kết quả phù hợp.</div>';
                            } else {
                                // Group results by type
                                const groups = data.reduce((acc, item) => {
                                    if (!acc[item.type]) acc[item.type] = [];
                                    acc[item.type].push(item);
                                    return acc;
                                }, {});

                                let html = '';
                                for (const [type, items] of Object.entries(groups)) {
                                    html += `
                                        <div class="px-4 py-2 bg-white/5 border-y border-white/5 text-xs font-bold text-slate-400 uppercase tracking-wider sticky top-0 backdrop-blur-md z-10">
                                            ${type}
                                        </div>
                                    `;
                                    items.forEach(item => {
                                        html += `
                                            <a href="${item.url}" class="flex items-start gap-3 p-3 hover:bg-white/10 transition-colors cursor-pointer border-b border-white/5 last:border-0 block">
                                                <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                                                    <span class="material-icons text-primary text-sm">${item.icon}</span>
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <div class="text-sm font-semibold text-white truncate">${item.title}</div>
                                                    <div class="text-xs text-slate-400 truncate mt-0.5">${item.description || ''}</div>
                                                </div>
                                            </a>
                                        `;
                                    });
                                }
                                dropdown.innerHTML = html;
                            }
                            dropdown.classList.remove('opacity-0', 'invisible');
                        })
                        .catch(err => {
                            console.error('Search error:', err);
                        });
                }, 300); // 300ms debounce
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', function (e) {
                if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
                    dropdown.classList.add('opacity-0', 'invisible');
                }
            });
            
            // Re-open on focus if there's text
            searchInput.addEventListener('focus', function () {
                if (this.value.trim().length > 0 && dropdown.innerHTML.trim() !== '') {
                    dropdown.classList.remove('opacity-0', 'invisible');
                }
            });
        }
    });
</script>
