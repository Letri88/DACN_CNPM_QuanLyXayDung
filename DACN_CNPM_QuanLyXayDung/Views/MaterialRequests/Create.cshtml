@model DACN_CNPM_QuanLyXayDung.Models.MaterialRequest

@{
    ViewData["Title"] = "Tạo Yêu cầu Nhập vật tư";
}

<div class="mb-6">
    <h1 class="text-2xl font-bold text-white tracking-tight">Tạo phiếu yêu cầu mới</h1>
    <p class="text-slate-400 mt-1">Điền lý do và chọn vật tư cần nhập thêm vào hệ thống kho.</p>
</div>

<form asp-action="Create" class="space-y-6">
    <div asp-validation-summary="ModelOnly" class="text-rose-400 mb-4 text-sm bg-rose-500/10 p-3 rounded-xl border border-rose-500/20"></div>

    <div class="glass-card rounded-2xl border border-white/5 p-6 space-y-6">
        <h2 class="text-lg font-semibold text-white border-b border-white/10 pb-2">Thông tin chung</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label asp-for="Reason" class="block text-sm font-medium text-slate-300 mb-2">Lý do yêu cầu</label>
                <input asp-for="Reason" class="w-full bg-background-dark/50 border border-white/10 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors" placeholder="VD: Sắp hết xi măng xây móng..." required />
                <span asp-validation-for="Reason" class="text-rose-400 text-xs mt-1 block"></span>
            </div>
            <div>
                <label asp-for="ExpectedDate" class="block text-sm font-medium text-slate-300 mb-2">Ngày mong muốn nhận hàng</label>
                <input asp-for="ExpectedDate" type="date" class="w-full bg-background-dark/50 border border-white/10 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors" />
                <span asp-validation-for="ExpectedDate" class="text-rose-400 text-xs mt-1 block"></span>
            </div>
        </div>
    </div>

    <div class="glass-card rounded-2xl border border-white/5 p-6">
        <div class="flex justify-between items-end border-b border-white/10 pb-2 mb-4">
            <h2 class="text-lg font-semibold text-white">Danh sách vật tư cần nhập</h2>
            <button type="button" id="addRow" class="text-sm px-3 py-1.5 bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/20 rounded-lg flex items-center gap-1 transition-colors">
                <span class="material-icons text-sm">add</span> Thêm loại vật tư
            </button>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left" id="materialsTable">
                <thead>
                    <tr class="text-slate-400 text-xs uppercase tracking-wider">
                        <th class="pb-3 w-1/3">Tên vật tư</th>
                        <th class="pb-3 w-1/4 min-w-[120px]">Số lượng yêu cầu</th>
                        <th class="pb-3">Ghi chú thêm</th>
                        <th class="pb-3 w-16 text-center">Xóa</th>
                    </tr>
                </thead>
                <tbody class="space-y-4">
                    <tr class="group">
                        <td class="pr-3 pb-3">
                            <select name="MaterialId" class="w-full bg-background-dark border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary" asp-items="ViewBag.MaterialId"></select>
                        </td>
                        <td class="pr-3 pb-3">
                            <input type="number" name="QuantityRequested" class="w-full bg-background-dark border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary" min="1" required placeholder="Nhập SL..." />
                        </td>
                        <td class="pr-3 pb-3">
                            <input type="text" name="Note" class="w-full bg-background-dark border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary" placeholder="Tùy chọn..." />
                        </td>
                        <td class="pb-3 text-center">
                            <button type="button" class="remove-row p-2 text-rose-400 hover:bg-rose-500/10 rounded-lg transition-colors opacity-50 group-hover:opacity-100" title="Xóa dòng">
                                <span class="material-icons text-sm">delete</span>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="flex gap-4 pt-2">
        <button type="submit" class="px-6 py-2.5 bg-primary text-background-dark font-semibold rounded-xl hover:bg-opacity-90 transition-all shadow-lg shadow-primary/20">
            Gửi Yêu Cầu
        </button>
        <a asp-action="Index" class="px-6 py-2.5 bg-white/5 text-white font-medium rounded-xl hover:bg-white/10 transition-colors">
            Hủy Bỏ
        </a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            $('#addRow').click(function () {
                var firstRow = $('#materialsTable tbody tr:first').clone();
                firstRow.find('input').val('');
                $('#materialsTable tbody').append(firstRow);
            });

            $(document).on('click', '.remove-row', function () {
                if ($('#materialsTable tbody tr').length > 1) {
                    $(this).closest('tr').remove();
                } else {
                    alert("Bạn phải yêu cầu ít nhất một vật tư.");
                }
            });
        });
    </script>
}
