@model IEnumerable<DACN_CNPM_QuanLyXayDung.Models.PurchaseOrder>

@{
    ViewData["Title"] = "Đơn Đặt Hàng (PO)";
}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-white tracking-tight">Danh sách Đơn Đặt Hàng (PO)</h1>
</div>

<div class="glass-card rounded-2xl border border-white/5 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-white/5 border-b border-white/5 text-slate-300 text-sm font-semibold">
                    <th class="p-4">Mã Đơn Tự Động</th>
                    <th class="p-4">Mã Phiếu Yêu Cầu Gốc</th>
                    <th class="p-4">Nhà Cung Cấp</th>
                    <th class="p-4">Ngày Lập</th>
                    <th class="p-4 text-right">Tổng Tiền (Ước tính)</th>
                    <th class="p-4">Trạng Thái</th>
                    <th class="p-4 text-center">Thao Tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5 text-slate-300">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-white/[0.02] transition-colors">
                        <td class="p-4 font-medium text-white">@item.POCode</td>
                        <td class="p-4 text-slate-400">@item.Request?.RequestCode</td>
                        <td class="p-4">@(item.Supplier?.Name ?? "Chưa xác định")</td>
                        <td class="p-4 text-sm">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="p-4 text-right font-semibold text-primary">@item.TotalAmount.ToString("N0") VNĐ</td>
                        <td class="p-4">
                            @if (item.Status == "Draft")
                            {
                                <span class="px-3 py-1 rounded-full text-[11px] font-medium bg-slate-500/20 text-slate-400 border border-slate-500/30 uppercase tracking-wider">Bản Nháp (Draft)</span>
                            }
                            else if (item.Status == "Sent")
                            {
                                <span class="px-3 py-1 rounded-full text-[11px] font-medium bg-blue-500/20 text-blue-400 border border-blue-500/30 uppercase tracking-wider">Đã Gửi (Sent)</span>
                            }
                            else if (item.Status == "Completed")
                            {
                                <span class="px-3 py-1 rounded-full text-[11px] font-medium bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 uppercase tracking-wider">Hoàn tất</span>
                            }
                            else
                            {
                                <span class="px-3 py-1 rounded-full text-[11px] font-medium bg-amber-500/20 text-amber-400 border border-amber-500/30 uppercase tracking-wider">@item.Status</span>
                            }
                        </td>
                        <td class="p-4 text-center space-x-2 whitespace-nowrap">
                            <a asp-action="Details" asp-route-id="@item.POId" class="px-3 py-1.5 bg-white/5 text-white hover:bg-white/10 rounded-lg transition-colors text-sm font-medium">Chi tiết</a>
                            
                            @if (item.Status == "Sent")
                            {
                                <a asp-controller="MaterialReceipts" asp-action="Create" asp-route-poId="@item.POId" class="px-3 py-1.5 bg-emerald-500/20 text-emerald-400 hover:bg-emerald-500/30 rounded-lg transition-colors text-sm font-medium">Hàng đã về & Nhập kho</a>
                            }
                        </td>
                    </tr>
                }
                @if(!Model.Any()) {
                    <tr><td colspan="7" class="p-8 text-center text-slate-500">Chưa có PO nào được sinh ra. (Hãy duyệt yêu cầu nhập!)</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
