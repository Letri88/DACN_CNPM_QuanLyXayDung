@model IEnumerable<DACN_CNPM_QuanLyXayDung.Models.MaterialReceipt>

@{
    ViewData["Title"] = "Quản lý Sinh phiếu / Nhập kho";
}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-white tracking-tight">Danh sách các lần Nhập kho</h1>
</div>

<div class="glass-card rounded-2xl border border-white/5 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-white/5 border-b border-white/5 text-slate-300 text-sm font-semibold">
                    <th class="p-4">Mã Phiếu Nhập</th>
                    <th class="p-4">PO Tham Chiếu</th>
                    <th class="p-4">Người Nhận Hàng</th>
                    <th class="p-4">Ngày Nhận</th>
                    <th class="p-4">Trạng Thái</th>
                    <th class="p-4 text-center">Thao Tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5 text-slate-300">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-white/[0.02] transition-colors">
                        <td class="p-4 font-medium text-primary">@item.ReceiptCode</td>
                        <td class="p-4">@(item.PurchaseOrder?.POCode ?? "Không có")</td>
                        <td class="p-4">@(item.Receiver?.FullName ?? item.ReceiverId)</td>
                        <td class="p-4">@item.ReceivedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="p-4">
                            <span class="px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 uppercase">@item.Status</span>
                        </td>
                        <td class="p-4 text-center">
                            <a asp-action="Details" asp-route-id="@item.ReceiptId" class="p-2 bg-blue-500/10 text-blue-400 hover:bg-blue-500/20 rounded-lg transition-colors inline-block" title="Xem chi tiết phiếu nhập">
                                <span class="material-icons text-sm">visibility</span>
                            </a>
                        </td>
                    </tr>
                }
                @if(!Model.Any()) {
                    <tr><td colspan="6" class="p-8 text-center text-slate-500">Chưa có dữ liệu phiếu nhập kho thực tế nào được lập.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
