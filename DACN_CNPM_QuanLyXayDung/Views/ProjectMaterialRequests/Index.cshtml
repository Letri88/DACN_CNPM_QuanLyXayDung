@using System.Security.Claims
@model IEnumerable<DACN_CNPM_QuanLyXayDung.Models.ProjectMaterialRequest>
@{
    ViewData["Title"] = "Yêu Cầu Vật Tư Dự Án";
}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-white tracking-tight">Danh sách Yêu Cầu Vật Tư Dự Án</h1>
    @if (User.IsInRole("Engineer") || User.IsInRole("Kỹ sư") || User.IsInRole("Admin") || User.IsInRole("Quản trị viên"))
    {
        <a asp-action="Create" class="px-5 py-2.5 bg-primary text-background-dark font-semibold rounded-xl hover:bg-opacity-90 transition-all shadow-lg shadow-primary/20 flex items-center gap-2">
            <span class="material-icons text-sm">add</span> Tạo phiếu yêu cầu
        </a>
    }
</div>

<div class="glass-card rounded-2xl border border-white/5 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-white/5 border-b border-white/5 text-slate-300 text-sm font-semibold">
                    <th class="p-4">Mã Yêu Cầu</th>
                    <th class="p-4">Dự Án</th>
                    <th class="p-4">Lập Bởi</th>
                    <th class="p-4">Ngày Tạo</th>
                    <th class="p-4">Trạng Thái</th>
                    <th class="p-4 text-center">Thao Tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5 text-slate-300">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-white/[0.02] transition-colors">
                        <td class="p-4 font-medium text-white">@item.RequestCode</td>
                        <td class="p-4 text-primary">@(item.Project?.ProjectName ?? "Không xác định")</td>
                        <td class="p-4">@(item.Requester?.FullName ?? item.RequesterId)</td>
                        <td class="p-4">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="p-4">
                            @if (item.Status == "Pending")
                            {
                                <span class="px-3 py-1 rounded-full text-xs font-medium bg-amber-500/20 text-amber-400 border border-amber-500/30">Chờ Quản lý Duyệt</span>
                            }
                            else if (item.Status == "Approved")
                            {
                                <span class="px-3 py-1 rounded-full text-xs font-medium bg-blue-500/20 text-blue-400 border border-blue-500/30">Đã Duyệt (Chờ xuất)</span>
                            }
                            else if (item.Status == "Exported")
                            {
                                <span class="px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">Đã Xuất Kho</span>
                            }
                            else
                            {
                                <span class="px-3 py-1 rounded-full text-xs font-medium bg-rose-500/20 text-rose-400 border border-rose-500/30">@item.Status</span>
                            }
                        </td>
                        <td class="p-4 text-center space-x-2 whitespace-nowrap">
                            <a asp-action="Details" asp-route-id="@item.RequestId" class="px-3 py-1.5 bg-white/5 text-white hover:bg-white/10 rounded-lg transition-colors text-sm font-medium">Xem chi tiết</a>
                            
                            @if (item.Status == "Approved" && (User.IsInRole("Warehouse Keeper") || User.IsInRole("Thủ kho") || User.IsInRole("Warehouse keeper") || User.IsInRole("Admin")))
                            {
                                <a asp-action="Export" asp-route-id="@item.RequestId" class="px-3 py-1.5 bg-emerald-500 hover:bg-emerald-600 text-white font-medium rounded-lg transition-all shadow-lg shadow-emerald-500/20 text-sm flex-inline items-center gap-1">
                                    <span class="material-icons text-[12px]">exit_to_app</span> Xuất Kho Nhiệm Vụ
                                </a>
                            }
                        </td>
                    </tr>
                }
                @if(!Model.Any()) {
                    <tr><td colspan="6" class="p-8 text-center text-slate-500">Chưa có yêu cầu xuất vật tư cho dự án.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
