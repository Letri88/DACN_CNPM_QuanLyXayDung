@model DACN_CNPM_QuanLyXayDung.Models.SiteDiary

@{
    ViewData["Title"] = "Chi tiết Nhật ký thi công";
}

<div class="mb-6 flex justify-between items-center">
    <div>
        <h1 class="text-2xl font-bold text-white tracking-tight">Chi tiết Nhật ký thi công</h1>
        <p class="text-slate-400 mt-1">Ngày: @Model.Date.ToString("dd/MM/yyyy") - Dự án: <span class="font-semibold text-white">@Model.Project?.ProjectName</span></p>
    </div>
    <a asp-action="Index" class="px-5 py-2.5 bg-white/5 text-white font-medium rounded-xl hover:bg-white/10 transition-colors flex items-center gap-2">
        <span class="material-icons text-sm">arrow_back</span> Quay lại
    </a>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
        <div class="glass-card rounded-2xl border border-white/5 p-6 space-y-4">
            <h2 class="text-lg font-bold text-white border-b border-white/10 pb-2 mb-4 flex items-center gap-2">
                <span class="material-icons text-primary text-xl">assignment_turned_in</span> Nội dung công việc
            </h2>
            
            <div class="bg-background-dark/50 rounded-xl p-4 border border-white/5 whitespace-pre-wrap text-slate-300">@Model.WorkCompleted</div>

            @if (!string.IsNullOrEmpty(Model.Issues))
            {
                <h3 class="text-sm font-bold text-rose-400 mt-4 mb-2 flex items-center gap-2">
                    <span class="material-icons text-rose-400 text-[16px]">warning</span> Sự cố / Kiến nghị
                </h3>
                <div class="bg-rose-500/10 rounded-xl p-4 border border-rose-500/20 whitespace-pre-wrap text-rose-200">@Model.Issues</div>
            }
        </div>

        @if (Model.PhotoContent != null)
        {
            <div class="glass-card rounded-2xl border border-white/5 p-6">
                <h2 class="text-lg font-bold text-white border-b border-white/10 pb-2 mb-4 flex items-center gap-2">
                    <span class="material-icons text-primary text-xl">image</span> Ảnh hiện trường
                </h2>
                <div class="rounded-xl overflow-hidden border border-white/10 bg-black/50">
                    <img src="@Url.Action("GetPhoto", "SiteDiaries", new { id = Model.DiaryId })" alt="Ảnh hiện trường" class="w-full h-auto object-contain max-h-[600px]" />
                </div>
            </div>
        }
    </div>

    <div class="space-y-6">
        <div class="glass-card rounded-2xl border border-white/5 p-6">
            <h2 class="text-lg font-bold text-white border-b border-white/10 pb-2 mb-4 flex items-center gap-2">
                <span class="material-icons text-primary text-xl">info</span> Thông tin chung
            </h2>
            
            <ul class="space-y-4 text-sm">
                <li class="flex justify-between items-center border-b border-white/5 pb-2">
                    <span class="text-slate-400">Người lập</span>
                    <span class="font-medium text-white">@Model.Engineer?.FullName</span>
                </li>
                <li class="flex justify-between items-center border-b border-white/5 pb-2">
                    <span class="text-slate-400">Giai đoạn</span>
                    <span class="font-medium text-white">@(Model.Stage?.StageName ?? "Không phân loại")</span>
                </li>
                <li class="flex justify-between items-center border-b border-white/5 pb-2">
                    <span class="text-slate-400">Thời gian tạo</span>
                    <span class="font-medium text-white">@Model.CreatedAt.ToString("HH:mm - dd/MM/yyyy")</span>
                </li>
            </ul>
        </div>

        <div class="glass-card rounded-2xl border border-white/5 p-6">
            <h2 class="text-lg font-bold text-white border-b border-white/10 pb-2 mb-4 flex items-center gap-2">
                <span class="material-icons text-primary text-xl">thermostat</span> Điều kiện & Nguồn lực
            </h2>
            
            <div class="grid grid-cols-2 gap-4">
                <div class="bg-background-dark/50 p-4 rounded-xl border border-white/5 text-center">
                    <span class="material-icons text-amber-400 block mb-1">wb_sunny</span>
                    <div class="text-xs text-slate-400">Thời tiết</div>
                    <div class="font-bold text-white">@(Model.Weather ?? "-")</div>
                </div>
                <div class="bg-background-dark/50 p-4 rounded-xl border border-white/5 text-center">
                    <span class="material-icons text-blue-400 block mb-1">device_thermostat</span>
                    <div class="text-xs text-slate-400">Nhiệt độ</div>
                    <div class="font-bold text-white">@(Model.Temperature ?? "-")</div>
                </div>
                <div class="bg-background-dark/50 p-4 rounded-xl border border-white/5 text-center">
                    <span class="material-icons text-emerald-400 block mb-1">engineering</span>
                    <div class="text-xs text-slate-400">Công nhân</div>
                    <div class="font-bold text-white">@Model.WorkerCount</div>
                </div>
                <div class="bg-background-dark/50 p-4 rounded-xl border border-white/5 text-center">
                    <span class="material-icons text-indigo-400 block mb-1">precision_manufacturing</span>
                    <div class="text-xs text-slate-400">Máy móc</div>
                    <div class="font-bold text-white">@Model.MachineryCount</div>
                </div>
            </div>
        </div>
    </div>
</div>
